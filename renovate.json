{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "security:minimumReleaseAgeNpm",
    "schedule:weekly"
  ],
  "prConcurrentLimit": 2,
  "separateMajorMinor": false,
  "groupSingleUpdates": true,
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock"
  },
  "packageRules": [
    {
      "description": "Keep GitHub Actions on floating major tags; Renovate proposes major bumps.",
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "schedule": ["* * 1 * *"]
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "update"
    },
    {
      "description": "Vendored llama.cpp is a pinned submodule; do not Renovate its tree as a Cargo crate.",
      "matchManagers": ["cargo"],
      "matchFileNames": ["vendor/**"],
      "enabled": false
    }
  ]
}
